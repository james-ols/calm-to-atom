# Python
__pycache__/
*.py[cod]
*$py.class
*.egg-info/
.eggs/
build/
dist/
.installed.cfg
*.egg

# Virtual environments
.venv/
venv/
env/
ENV/

# Test / coverage
.pytest_cache/
.coverage
.coverage.*
htmlcov/
.tox/

# Editors / OS
.vscode/
.idea/
*.swp
.DS_Store

# Local agent/tooling config (not for distribution)
.claude/

# Local data — never commit real archive exports
*.csv

# --- Customer data (never commit) -----------------------------------------
# Everything under customers/ is treated as private customer material.
# We only allow-list a couple of scaffolding files so the folder can exist
# in git without leaking any payload.
/customers/**
!/customers/
!/customers/.gitkeep
!/customers/README.md

# Belt-and-braces: block common raw export formats anywhere in the tree,
# except the curated public samples under examples/.
*.xml
*.dscribe
!examples/*.xml
!examples/*.dscribe
